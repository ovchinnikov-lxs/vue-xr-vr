{
  "name": "vue-xr-ui",
  "version": "0.1.0",
  "description": "Vue components for building WebXR (VR/MR) interfaces on TresJS and Three.js.",
  "keywords": [
    "vue",
    "webxr",
    "vr",
    "mixed-reality",
    "xr",
    "threejs",
    "tresjs",
    "quest",
    "ui-kit",
    "components"
  ],
  "homepage": "https://vue-xr-ui.vercel.app",
  "bugs": {
    "url": "https://github.com/ovchinnikov-lxs/vue-xr-vr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovchinnikov-lxs/vue-xr-vr.git",
    "directory": "packages/vue-xr-ui"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@iwer/devui": "^2.6.0",
    "@iwer/sem": "^2.6.0",
    "@pmndrs/pointer-events": "^6.6.32",
    "@pmndrs/uikit": "^1.0.77",
    "@pmndrs/xr": "^6.6.32",
    "@preact/signals-core": "^1.14.4",
    "@vue-xr-ui/tokens": "workspace:*",
    "iwer": "^2.6.0"
  },
  "peerDependencies": {
    "@tresjs/core": "^5.9.0",
    "three": ">=0.170",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tresjs/core": "^5.9.3",
    "@types/three": "^0.186.0",
    "@types/webxr": "^0.5.24",
    "three": "^0.186.1",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "module": "./dist/index.js"
  },
  "author": "Aleksandr Ovchinnikov (https://github.com/ovchinnikov-lxs)"
}
